# Copy to .env.local for local development (never commit .env.local)

# Postgres connection.
#   Local:     postgres://postgres@localhost:5432/phase10
#   Supabase:  Project Settings > Database > Connection string > "Transaction pooler" (port 6543)
DATABASE_URL=postgres://postgres@localhost:5432/phase10

# 32+ random characters. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase Realtime (optional locally; without these the app polls every 1.5 s)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Phone alerts (Web Push, free). Generate a pair with:
#   node -e "const k=require('web-push').generateVAPIDKeys();console.log(k)"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://phase10-react.vercel.app

# Daily scheduled job (vercel.json "crons"). Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Voice chat at tables (LiveKit Cloud, free Build plan). Leave empty to keep voice unavailable.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
